local.properties
gradle-local.properties
*.local.properties

# Secrets and local environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
*.bak
*.orig
*.swp
*~

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
